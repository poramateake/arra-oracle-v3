# Copy outside the repository to /etc/arra-oracle/private.env (mode 600).
# Do not commit the copy. Mint's existing ARRA/MCP token remains authoritative.
ARRA_API_TOKEN=existing-mint-bearer-token
# Optional separate MCP token; omitted means MCP uses ARRA_API_TOKEN.
# ORACLE_MCP_HTTP_TOKEN=
# Hermes/Grok and the optional Codex fallback run through the separate
# loopback adapter env. This Arra env deliberately has no inference secret.
ORACLE_EMBEDDER=none
ORACLE_VECTOR_DB=sqlite-vec
VECTOR_FALLBACK=fts5
# Optional semantic embeddings may be enabled later with a separately
# approved provider; do not set OpenAI here merely to enable chat inference.
