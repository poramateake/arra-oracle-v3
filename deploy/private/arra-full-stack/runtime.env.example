# Copy outside the repository to /etc/arra-oracle/private.env (mode 600).
# Do not commit the copy. Mint's existing ARRA/MCP token remains authoritative.
ARRA_API_TOKEN=existing-mint-bearer-token
# Optional separate MCP token; omitted means MCP uses ARRA_API_TOKEN.
# ORACLE_MCP_HTTP_TOKEN=
OPENAI_API_KEY=enter-on-Mac-then-stream-to-Mint
# Arra validates this pin at startup; repeat it in openai.env for the adapter.
# Pin only after a preflight model-list check; no implicit fallback.
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Keep adapter-only settings in /etc/arra-oracle/openai.env; this file is for Arra.
