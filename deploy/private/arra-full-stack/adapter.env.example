# Copy outside the repository to /etc/arra-oracle/openai.env (mode 600).
# This file is intentionally separate: the adapter never receives Mint's bearer token.
OPENAI_API_KEY=enter-on-Mac-then-stream-to-Mint
# Pin only after a preflight model-list check; no implicit fallback.
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_CONCURRENCY=2
OPENAI_MIN_INTERVAL_MS=0
OPENAI_MAX_OUTPUT_TOKENS=700
